{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/assets/(.*)", "destination": "/frontend/dist/assets/$1" },
    { "source": "/favicon.svg", "destination": "/frontend/dist/favicon.svg" },
    { "source": "/icons.svg", "destination": "/frontend/dist/icons.svg" },
    { "source": "/(.*)", "destination": "/frontend/dist/index.html" }
  ]
}
